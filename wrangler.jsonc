// Deploys SynthIDStripper to Cloudflare: `npx wrangler deploy` builds the web app
// (npm run build → dist/, served by the Worker as static assets), builds the
// Dockerfile (Docker must be running locally; Workers Builds does it for you
// on push) and puts the Worker (worker/index.js) in front of it. The Worker
// answers pages, sign-in, /api/me, usage and billing itself; the container
// only wakes for server strips and downloads the Worker has let through.
// Secrets are set with `npx wrangler secret put NAME` (see
// docs/accounts-and-billing.md); plain settings go in "vars" below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metadata-stripper",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // The account code (server/accounts-core.js) uses node:crypto and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // dist/ is built before every deploy (and `wrangler dev`).
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker routes every request (pages get SITE_URL filled in), and
    // fetches files by their exact path.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "containers": [
    {
      "class_name": "SharonaServer",
      "image": "./Dockerfile",
      // ffmpeg re-encodes and yt-dlp downloads need real CPU and memory.
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "SharonaServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SharonaServer"] }],

  // The Worker reads accounts through this binding (env.DB); it also lets
  // `npx wrangler d1 execute sharona …` find the database. The container
  // reaches D1 over the HTTP API with the vars/secrets below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sharona",
      "database_id": "7c9bd4b8-ee67-4223-bf5f-3022f455dbd1",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "SITE_URL": "https://metadata-stripper.synthidstripper.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "2bea5f5913224c4187853654b06c748f",
    "CLOUDFLARE_D1_DATABASE_ID": "7c9bd4b8-ee67-4223-bf5f-3022f455dbd1"
  },

  // Branch previews (`npx wrangler preview`, which Workers Builds runs for
  // every branch but main). Nothing above applies to a Preview except
  // `migrations`, `assets`, `build` and the compatibility settings, so this
  // block restates what a Preview needs, pointed at preview-only resources:
  //   - its own D1 database (sharona-preview), never production accounts.
  //     Shared by all Previews; `npm run db:preview:migrate` applies migrations/.
  //   - its own Durable Object namespace, container app and instance, made
  //     per Preview by Cloudflare because the class is declared here.
  //   - a small container (basic, one instance) that sleeps after 3 minutes.
  //   - NODE_ENV=development: dev sign-in and free test upgrades, so no
  //     Google or Stripe secrets and no real billing. Production has no
  //     NODE_ENV and keeps the real rules.
  // The one secret, SESSION_SECRET, is set once with
  // `npx wrangler preview base-config secret put SESSION_SECRET`.
  // See docs/previews.md.
  "previews": {
    "vars": {
      "NODE_ENV": "development",
      // Empty: links and sign-in use the Preview's own URL.
      "SITE_URL": "",
      "CLOUDFLARE_ACCOUNT_ID": "2bea5f5913224c4187853654b06c748f",
      "CLOUDFLARE_D1_DATABASE_ID": "b821ff32-4b1c-4548-975b-b15482f278f3",
      // Only the container reads this (the Worker always keeps the paywall
      // on and checks sign-in and plan): on a Preview the container doesn't
      // count usage itself, so it needs no CLOUDFLARE_API_TOKEN.
      "PAYWALL": "off",
      "SLEEP_AFTER": "3m",
      "MAX_UPLOAD_MB": "500",
      "MAX_DOWNLOAD_MB": "500"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "sharona-preview",
        "database_id": "b821ff32-4b1c-4548-975b-b15482f278f3",
        "migrations_dir": "migrations"
      }
    ],
    "containers": [
      {
        "class_name": "SharonaServer",
        "image": "./Dockerfile",
        "instance_type": "basic",
        "max_instances": 1
      }
    ],
    "durable_objects": {
      "bindings": [{ "name": "SERVER", "class_name": "SharonaServer" }]
    }
  }
}
