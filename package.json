{
  "name": "metadata-stripper",
  "version": "1.0.0",
  "description": "Creator tools web app: strip metadata from photos/videos and download from YouTube, X, Instagram and TikTok",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "dev:local": "LOCAL_UNLIMITED=1 concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit -p web && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "npm run build && npm start",
    "test": "node --test test/*.test.js",
    "db:preview:migrate": "wrangler d1 migrations apply sharona-preview --remote --config wrangler.preview-migrations.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonidglazyrin/Metadata-stripper.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/leonidglazyrin/Metadata-stripper/issues"
  },
  "homepage": "https://github.com/leonidglazyrin/Metadata-stripper#readme",
  "dependencies": {
    "express": "^4.22.3",
    "multer": "^1.4.4",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true,
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "heic-to": "^1.6.7",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.160.1"
  }
}
