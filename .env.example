# Copy to .env (never commit it) or set these in your host's dashboard.
# With none of the account variables set and NODE_ENV not "production",
# the app runs in dev mode: a local test sign-in and a free instant "upgrade".

SITE_URL=https://sharona.example          # public origin, no trailing slash
CONTACT_EMAIL=support@sharona.example    # shown on /privacy/ and /terms/ (default: support@<your domain>)
SESSION_SECRET=                           # long random string: openssl rand -hex 32
DATA_DIR=./data                           # where sharona.db lives; use a persistent volume

# Google sign-in (Google Cloud console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe ($20/month Pro)
STRIPE_SECRET_KEY=                        # sk_live_… or sk_test_…
STRIPE_PRICE_ID=                          # price_… of the $20/month recurring price
STRIPE_WEBHOOK_SECRET=                    # whsec_… of the webhook endpoint

# Optional
# PAYWALL=off                             # turn sign-in and limits off entirely
# FREE_STRIPS=1
# FREE_DOWNLOADS=1
# PRICE_LABEL=$20                         # shown in the upgrade dialog
