# Copy to .env (never commit it) or set these in your host's dashboard.
# With no Google/Stripe variables set and NODE_ENV not "production", sign-in
# and billing run in dev mode (a test sign-in and a free instant "upgrade"),
# but the D1 database is always required unless PAYWALL=off.

SITE_URL=https://sharona.example          # public origin, no trailing slash
CONTACT_EMAIL=support@sharona.example    # shown on /privacy/ and /terms/ (default: support@<your domain>)
SESSION_SECRET=                           # long random string: openssl rand -hex 32. Same value on every container

# Cloudflare D1: accounts, subscriptions and usage (see docs/accounts-and-billing.md).
# Server only: never expose the API token to the browser.
CLOUDFLARE_ACCOUNT_ID=                    # dashboard → Workers & Pages overview, or `npx wrangler whoami`
CLOUDFLARE_D1_DATABASE_ID=                # printed by `npx wrangler d1 create sharona`
CLOUDFLARE_API_TOKEN=                     # custom token with Account · D1 · Edit

# Google sign-in (Google Cloud console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe: two monthly plans and a one-time strip pack (see docs/accounts-and-billing.md)
STRIPE_SECRET_KEY=                        # sk_live_… or sk_test_…
STRIPE_PRICE_ID_BASIC=                    # price_… of the $10/month Basic price (on-device stripping)
STRIPE_PRICE_ID_PRO=                      # price_… of the $20/month Pro price (everything). STRIPE_PRICE_ID still works as its old name
STRIPE_PRICE_ID_PACK=                     # price_… of the $2 one-time strip pack (10 on-device strips, can be bought again)
STRIPE_WEBHOOK_SECRET=                    # whsec_… of the webhook endpoint

# Optional
# PAYWALL=off                             # turn sign-in and limits off entirely
# Free uses per account come from the app_settings table in D1 (1 each
# by default), so you can change them without a deploy. These override it:
# FREE_STRIPS=1                           # on-device strips
# FREE_SERVER_STRIPS=1                    # server strips
# FREE_DOWNLOADS=1
# PRICE_LABEL_BASIC=$10                   # shown in the upgrade dialog
# PRICE_LABEL_PRO=$20
# PRICE_LABEL_PACK=$2
# PACK_STRIPS=10                          # on-device strips per pack
